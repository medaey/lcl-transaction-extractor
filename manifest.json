{
  "manifest_version": 3,
  "name": "LCL — Extrait d'Opérations",
  "version": "2.4",
  "description": "Extraction et calcul des dépenses/gains des opérations bancaires LCL par mois.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
